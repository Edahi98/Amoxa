{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@schemas/*": ["./src/db/schema/*"],
      "@schemas-organizacion/*": ["./src/db/schema/organizacion/*"],
      "@schemas-auditoria/*": ["./src/db/schema/auditoria/*"],
      "@schemas-auditor/*": ["./src/db/schema/auditor/*"],
      "@schemas-evidencia/*": ["./src/db/schema/evidencia/*"],
      "@schemas-informe/*": ["./src/db/schema/informe/*"],
      "@db/*": ["./src/db/*"],
      "@auth/*": ["./src/auth/*"],
      "@auth-guards/*": ["./src/auth/guards/*"],
      "@auth-types/*": ["./src/auth/types/*"],
      "@auth-token/*": ["./src/auth/token/*"],
      "@validators/*": ["./src/validators/*"],
      "@common/*": ["./src/common/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  }
}
